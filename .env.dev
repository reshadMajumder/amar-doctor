# Development Environment Configuration
# This file is NOT committed to version control (add to .gitignore)

# Django Settings
SECRET_KEY=django-insecure-dev-key-please-change-this
DEBUG=True

# Database Configuration
DB_NAME=amardoctor
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_CELERY_DB=0

# Application Configuration
ALLOWED_HOSTS=localhost,127.0.0.1,django,nginx,*.ngrok.io
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080,http://localhost:5173

# Email Configuration (Gmail)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Amardoctor <noreply@amardoctor.com>

# AI Provider Settings
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key

# Payment Gateway (SSLCommerz)
SSL_STORE_ID=your-store-id
SSL_STORE_PASSWORD=your-store-password
SSL_SANDBOX_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php

# Public Domain (for redirects and webhooks)
PUBLIC_DOMAIN=http://localhost:8000

# Development Settings
PORT=8000
