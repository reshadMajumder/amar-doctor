    {
      "name": "WebSockets",
      "item": [
        {
          "name": "1. AI Triage Socket (Connect)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "ws://127.0.0.1:8000/ws/triage/{{session_id}}/?token={{access_token}}",
              "protocol": "ws",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "port": "8000",
              "path": [
                "ws",
                "triage",
                "{{session_id}}",
                ""
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{access_token}}"
                }
              ]
            },
            "description": "Note: Postman supports WebSocket requests natively via 'New -> WebSocket Request'.\n\nTo start a session, send this JSON message after connecting:\n\n{\n    \"event\": \"session.start\",\n    \"data\": {\n        \"symptoms\": \"I have a severe headache and dizziness.\"\n    }\n}\n\nTo answer a follow-up question, send:\n\n{\n    \"event\": \"patient.answer\",\n    \"data\": {\n        \"message\": \"It started yesterday morning.\"\n    }\n}"
          }
        }
      ]
    }
  ],
