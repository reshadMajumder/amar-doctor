            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"patient@example.com\",\n    \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password-reset/verify/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
