{
  "info": {
    "name": "Amardoctor API",
    "description": "API documentation for the AI-assisted telemedicine platform. Includes Authentication and Realtime AI Triage.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Patient Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"patient@example.com\",\n    \"password\": \"securepassword123\",\n    \"confirm_password\": \"securepassword123\",\n    \"full_name\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register/patient/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register",
                "patient",
                ""
              ]
            }
          }
        },
        {
