    {
      "name": "AI Triage",
      "item": [
        {
          "name": "1. Create Triage Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success) {",
                  "    pm.environment.set(\"session_id\", jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/triage/sessions/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "triage",
                "sessions",
                ""
              ]
            }
          }
        },
        {
          "name": "2. Get Triage Sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/triage/sessions/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "triage",
                "sessions",
                ""
              ]
            }
          }
        },
        {
          "name": "3. Get Session Details (Includes Messages)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/triage/sessions/{{session_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "triage",
                "sessions",
                "{{session_id}}",
                ""
              ]
            }
          }
        },
        {
          "name": "4. Get AI Reports",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
