# Amar Doctor - Environment Configuration Example
# Copy this file to .env and fill in your values
# This file should be in the core/ directory

# ============================================
# Django Configuration
# ============================================
SECRET_KEY=your_very_secure_django_secret_key_here_change_this
DEBUG=False
ENVIRONMENT=prod
ALLOWED_HOSTS=amardoc.reshad.dev,localhost,127.0.0.1

# ============================================
# CORS & CSRF Configuration
# ============================================
CORS_ALLOWED_ORIGINS=https://amardoc.reshad.dev
CSRF_TRUSTED_ORIGINS=https://amardoc.reshad.dev

# For development with ngrok tunnels, add:
# CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://*.ngrok-free.app,https://*.ngrok.io
# CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://*.ngrok-free.app,https://*.ngrok.io

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=amardoctor
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_here
DB_HOST=db
DB_PORT=5432

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://redis:6379/1
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=          # Leave empty if no password

# ============================================
# Celery Configuration
# ============================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC

# ============================================
# Email Configuration (Optional)
# ============================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@amardoctor.com

# ============================================
# AWS Configuration (Optional - for S3 storage)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# ============================================
# Google Gemini AI Configuration (Optional)
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Security Settings
# ============================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# ============================================
# Logging Configuration (Optional)
# ============================================
LOG_LEVEL=INFO
SENTRY_DSN=          # For error tracking with Sentry

# ============================================
# Gunicorn Configuration (Production)
# ============================================
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
GUNICORN_WORKER_CLASS=gthread
GUNICORN_THREADS=2
DJANGO_SETTINGS_MODULE=core.settings
