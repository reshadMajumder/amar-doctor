# Production Environment Configuration
# ⚠️ CRITICAL: Never commit this file to version control
# Create a copy and fill with production secrets

# Django Settings
SECRET_KEY=change-to-secure-random-key-minimum-50-chars
DEBUG=False

# Database Configuration
DB_NAME=amardoctor_prod
DB_USER=postgres
DB_PASSWORD=change-to-secure-password
DB_HOST=db
DB_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_CELERY_DB=0

# Application Configuration
ALLOWED_HOSTS=amardoc.reshad.dev,www.amardoc.reshad.dev
CORS_ALLOWED_ORIGINS=https://amardoc.reshad.dev,https://www.amardoc.reshad.dev

# Email Configuration
EMAIL_HOST_USER=your-production-email@gmail.com
EMAIL_HOST_PASSWORD=your-production-app-password
DEFAULT_FROM_EMAIL=Amardoctor <noreply@amardoctor.com>

# AI Provider Settings
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=your-production-gemini-api-key

# Payment Gateway (SSLCommerz) - Production Credentials
SSL_STORE_ID=your-production-store-id
SSL_STORE_PASSWORD=your-production-store-password
SSL_SANDBOX_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php

# Public Domain
PUBLIC_DOMAIN=https://amardoc.reshad.dev

# Server Configuration
PORT=8000

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
